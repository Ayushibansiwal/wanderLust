<% layout("/layouts/boilerplate") %>

<script> 
  const mapToken = "<%= process.env.MAP_TOKEN %>"; 
  const listing = <%- JSON.stringify(listing) %>; 
</script>

  <div class="container mt-4">

    <!-- Title -->
    <h2 class="mb-4 text-center">
      <%= listing.title %>
    </h2>

    <!-- Listing Section -->
    <div class="col-md-8 offset-md-2 section-wrapper">
      <div class="card show-card">

        <img src="<%= listing.image.url %>" alt="listing_image" class="show-card-img" />

        <div class="card-body">

          <p class="card-text">
            Created by :
            <i>
              <%= listing.owner.username %>
            </i>
          </p>

          <p class="card-text">
            <%= listing.description %>
          </p>

          <p class="card-text fw-bold">
            ₹ <%= listing.price.toLocaleString("en-IN") %> / night
          </p>

          <p class="card-text fw-bold">
            <%= listing.location %>, <%= listing.country %>
          </p>
              <!-- Category Display -->
          <div class="d-flex flex-wrap gap-2 my-2">
            <% listing.categories.forEach(catName => { %>
              <% const matchedCat = CATEGORIES.find(c => c.name === catName); %>
              <% if (matchedCat) { %>
                <span class="badge text-bg-light border px-3 py-2 fs-6">
                  <i class="<%= matchedCat.icon %> me-1" style="color: <%= matchedCat.color %>"></i> 
                  <%= matchedCat.name %>
                </span>
              <% } %>
            <% }) %>
          </div>

          <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>

            <div class="d-flex gap-2 mt-3">

              <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
                Edit
              </a>

              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-danger">
                  Delete
                </button>
              </form>

            </div>

            <% } %>

        </div>
      </div>
      <hr class="section-divider">
    </div>


    <!-- Review Form -->
    <% if(currentUser){ %>

      <div class="col-md-8 offset-md-2 section-wrapper">

        <h4 class="mb-3">Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate >

          <div class="mb-3">

            <label for="rating" class="form-label">
              Rating
            </label>

            <fieldset class="starability-basic">

              <legend>First rating:</legend>

              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                aria-label="No rating." />

              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>

              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>

              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>

              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>

              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>

            </fieldset>

          </div>

          <div class="mb-3">

            <label for="comment" class="form-label">
              Comment
            </label>

            <textarea 
            name="review[comment]" 
            id="comment" rows="5" 
            class="form-control" 
            required
            pattern=".*\S.*"></textarea>

            <div class="invalid-feedback">
              Please leave a comment for review
            </div>

            <div class="valid-feedback">
              Your review matters
            </div>

          </div>

          <button type="submit" class="btn btn-dark">
            Submit
          </button>

        </form>

        <hr class="section-divider">

      </div>

      <% } %>


        <!-- All Reviews -->
        <% if(listing.reviews.length> 0) { %>

          <div class="col-md-8 offset-md-2 section-wrapper">

            <h4 class="fw-semibold mb-4">
              All Reviews
            </h4>

            <div class="row g-4">

              <% for(let review of listing.reviews){ %>

                <div class="col-md-6">

                  <div class="card border rounded-4 h-100">

                    <div class="card-body p-4">

                      <div class="d-flex align-items-center mb-3">

                        <div
                          class="rounded-circle border d-flex justify-content-center align-items-center fw-bold me-3 review-avatar">
                          <%= review.author.username.charAt(0).toUpperCase() || "U" %>
                        </div>

                        <div>

                          <h6 class="mb-1 fw-bold">
                            <%= review.author.username || "Anonymous" %>
                          </h6>

                          <div class="text-warning small">
                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                          </div>

                        </div>

                      </div>

                      <p class="mb-4 text-body-secondary">
                        <%= review.comment %>
                      </p>

                      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        method="POST">

                        <button type="submit" class="btn btn-sm btn-danger rounded">
                          Delete
                        </button>

                      </form>

                    </div>

                  </div>

                </div>

                <% } %>

            </div>

            <hr class="section-divider">

          </div>

          <% } %>


            <!-- Map -->
            <div class="col-md-8 offset-md-2 section-wrapper">
              <h3 class="mb-3">Where you'll be</h3>
              <div id="map"></div>
            </div>
  </div>

<script src="/js/map.js"></script>