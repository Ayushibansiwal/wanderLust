<% layout("/layouts/boilerplate") %>

<div class="row py-3">
  <div class="col-lg-8 col-md-10 col-12 mx-auto">
    <h3>Create New Listing</h3>

    <form 
    action="/listings" 
    method="POST" 
    class="listing-form needs-validation" 
    novalidate 
    enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title">Title</label>
        <input 
        type="text" 
        name="listing[title]" 
        placeholder="Add a Catchy Title" 
        class="form-control"
        required
        >

        <div class="valid-feedback">
          Looks good!
        </div>
      </div>
      

      <div class="mb-3">
        <label for="description">Description</label>
        <textarea 
          name="listing[description]" 
          placeholder="Description" 
          rows="3" 
          class="form-control"
          required
          >
        </textarea>
        <div class="invalid-feedback">
          Please provide a short description.
        </div>
        <div class="valid-feedback">
          Looks good!
        </div>
      </div>

      <div class="mb-3">
        <label for="image">Upload Image</label>
        <input 
          type="file" 
          name="listing[image]" 
          placeholder="Image URL" 
          class="form-control"
          required>
          <div class="invalid-feedback">
            Please upload an image.
          </div>
          <div class="valid-feedback">
          Looks good!
          </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Select Categories for your Listing</label>
            <div class="d-flex flex-wrap gap-3">

            <% CATEGORIES.forEach(cat => { %>
                <div class="form-check">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        name="listing[categories]"
                        value="<%= cat.name %>"
                        id="<%= cat.name %>">

                    <label class="form-check-label"
                          for="<%= cat.name %>">

                        <i class="<%= cat.icon %>"></i>
                        <%= cat.name %>

                    </label>
                </div>
            <% }) %>  
        </div>
        <div class="invalid-feedback">
          Please provide a valid Price.
        </div>
         <div class="valid-feedback">
          Looks good!
        </div>
      </div>

      <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price">Price</label>
        <input 
        type="number" 
        name="listing[price]" 
        placeholder="Price (₹)" 
        class="form-control"
        required
        >
        <div class="invalid-feedback">
          Please provide a valid Price.
        </div>
         <div class="valid-feedback">
          Looks good!
        </div>
      </div>
      

      <div class="mb-3 col-md-8">
        <label for="country">Country</label>
        <input 
        type="text" 
        name="listing[country]" 
        placeholder="Country: India" 
        class="form-control"
        required
        >
        <div class="invalid-feedback">
          Please provide a valid Country.
        </div>
         <div class="valid-feedback">
          Looks good!
        </div>
      </div>
      </div>
      
      
      <div class="mb-3">
        <label for="location">Location</label>
        <input 
        type="text" 
        name="listing[location]" 
        placeholder="Location: Jaipur, Rajasthan" 
        class="form-control"
        required
        >
        <div class="invalid-feedback">
          Please provide a valid Location.
        </div>
         <div class="valid-feedback">
          Looks good!
        </div>
      </div>
      <button class="save-btn">Add Listing</button>
    </form>
  </div>
  </div>
</div>
